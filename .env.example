GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://your-domain.example/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=created_after_spotify_authorization
# Set to vercel only when the app is deployed on Vercel; Cloudflare is the VPS/tunnel default.
GEO_PROVIDER=cloudflare
